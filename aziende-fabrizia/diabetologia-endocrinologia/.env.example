# ── OpenAI (PubMed AI + Avatar) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Telegram (Avatar — legge gruppi medici di Fabrizia) ────────────────────────
# Ottieni da: https://my.telegram.org → My Applications
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ── Google Drive (opzionale — salva digest e bozze) ───────────────────────────
# Scarica credentials.json da Google Cloud Console → Drive API → OAuth2 desktop
GDRIVE_CREDENTIALS_PATH=credentials.json
GDRIVE_TOKEN_PATH=token.json

# ── NCBI PubMed (opzionale — aumenta rate limit da 3 a 10 req/s) ──────────────
NCBI_API_KEY=

# Research Radar: zero chiavi richieste — OpenAlex, Semantic Scholar,
# Europe PMC, CrossRef e ClinicalTrials.gov sono 100% gratuiti e senza key.
