# Copia questo file in .env e compila con le tue credenziali
# cp .env.example .env

# OpenAI API key (necessaria per l'estrazione automatica via GPT-4o Vision)
# Ottieni la chiave su https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite locale (default — nessuna config necessaria)
# DATABASE_URL=sqlite:///./data/receipts.db
#
# PostgreSQL su Railway (impostato automaticamente da Railway se si aggiunge
# un plugin Postgres al servizio):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Storage file ──────────────────────────────────────────────────────────────
# Directory dove vengono salvati gli upload (default: ./uploads)
# Su Railway, puntare al volume persistente montato:
# UPLOADS_DIR=/data/uploads

# ── CORS (API FastAPI) ────────────────────────────────────────────────────────
# Lista di origini autorizzate separate da virgola (default: solo localhost)
# CORS_ORIGINS=https://your-app.up.railway.app,https://yourdomain.com
