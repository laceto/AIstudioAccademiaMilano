# Copy to .env and fill in. Never commit .env or the credential files it points at.

# --- OAuth (desktop / local development) ---
GCAL_CREDENTIALS_FILE=./credentials.json
GCAL_TOKEN_FILE=./token.json

# --- Server / container alternatives (pick one) ---
# GCAL_TOKEN_JSON={"client_id":"...","client_secret":"...","refresh_token":"...","type":"authorized_user"}
# GCAL_SERVICE_ACCOUNT_FILE=/secrets/service-account.json
# GCAL_SUBJECT=luigi@studio.it

# --- Behaviour ---
GCAL_CALENDAR_ID=primary
GCAL_TIMEZONE=Europe/Rome
GCAL_READ_ONLY=false
GCAL_DRY_RUN=false
GCAL_MAX_RESULTS=25
GCAL_WORK_START=9
GCAL_WORK_END=18

# --- Model ---
GCAL_AGENT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
