# ============================================================
# AI Studio Accademia Milano — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
# See credentials/registry.md for step-by-step setup guides.
# ============================================================


# ── ANTHROPIC ────────────────────────────────────────────────
# Used by: D009 (LinkedIn posts), D010 (Valentina), D005 (chatbot), pipeline
# Get it: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here


# ── OPENAI ───────────────────────────────────────────────────
# Used by: D007 (calendar/event parser), D005 (chatbot), RAG scripts
# Get it: platform.openai.com → API Keys
OPENAI_API_KEY=sk-your-key-here


# ── GITHUB ───────────────────────────────────────────────────
# Used by: D009 (post generator), github_research scripts
# Get it: github.com/settings/tokens → New token (classic) → scope: public_repo
# Optional but raises rate limit 60 → 5000 req/h
GITHUB_TOKEN=ghp_your-token-here
RESEARCH_GITHUB_TOKEN=ghp_your-token-here   # can be same as GITHUB_TOKEN


# ── GMAIL / GOOGLE ───────────────────────────────────────────
# Used by: D002 (pdf-email), D003 (invoice-email), D007 (Google Calendar sync)
# Get it: see credentials/registry.md → Google section (OAuth flow)
# Files are local only — paths point to credentials.json / token.json
GOOGLE_CREDENTIALS_JSON=credentials.json
GOOGLE_TOKEN_JSON=google_token.json


# ── TELEGRAM ─────────────────────────────────────────────────
# Used by: D007 (calendar bot), D010 (Valentina publisher), pipeline
# Get it: Telegram → @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Channel/chat ID — use @channelusername or numeric ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_here
# RAG API server URL — second Railway service running scripts/rag/api_server.py
# /ask and ? prefix in gateway bots proxy here via POST /chat/sync
RAG_API_URL=http://localhost:8000


# ── TWITTER / X ──────────────────────────────────────────────
# Used by: D010 (Valentina publisher), pipeline
# Get it: developer.twitter.com → Projects & Apps → Keys and Tokens
TWITTER_API_KEY=your-api-key-here
TWITTER_API_SECRET=your-api-secret-here
TWITTER_ACCESS_TOKEN=your-access-token-here
TWITTER_ACCESS_SECRET=your-access-secret-here


# ── DISCORD ──────────────────────────────────────────────────
# Used by: D010 (Valentina publisher), pipeline
# Get it: Discord channel → Edit → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-here


# ── REDDIT ───────────────────────────────────────────────────
# Used by: D010 (Valentina publisher)
# Get it: reddit.com/prefs/apps → Create app → script type
REDDIT_CLIENT_ID=your-client-id-here
REDDIT_CLIENT_SECRET=your-client-secret-here
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password


# ── META / WHATSAPP ──────────────────────────────────────────
# Used by: D007 (WhatsApp calendar bot)
# Get it: developers.facebook.com → WhatsApp → API Setup
META_ACCESS_TOKEN=your-meta-access-token-here
META_VERIFY_TOKEN=aistudio_verify   # choose any string, must match webhook config


# ── TWILIO ───────────────────────────────────────────────────
# Used by: D007 (WhatsApp bot via Twilio sandbox)
# Get it: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACyour-account-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number (replace in prod)


# ── ALPACA (TRADING) ─────────────────────────────────────────
# Used by: D008 (algo trading bot) — PAPER trading only
# Get it: alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your-alpaca-api-key-here
ALPACA_SECRET_KEY=your-alpaca-secret-key-here


# ── MICROSOFT / OUTLOOK ──────────────────────────────────────
# Used by: D007 (Outlook Calendar sync)
# Get it: portal.azure.com → App registrations → New registration
MS_CLIENT_ID=your-client-id-here
MS_TENANT_ID=common   # or your tenant GUID
OUTLOOK_ACCESS_TOKEN=   # filled at runtime via OAuth, leave blank


# ── APPLE ICLOUD ─────────────────────────────────────────────
# Used by: D007 (Apple Calendar sync)
# IMPORTANT: app-specific password only — never your main Apple ID password
# Get it: appleid.apple.com → Sign-In & Security → App-Specific Passwords
APPLE_ICLOUD_USERNAME=your-apple-id@example.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
