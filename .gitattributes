# Auto-detect text files and normalize line endings to LF in the repo.
# Working tree on Windows can still be CRLF when core.autocrlf=true.
* text=auto eol=lf

# Explicit binary types (no normalization)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.ico  binary
*.woff  binary
*.woff2 binary

# Force LF on shell + Python + config (these break on CRLF)
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
