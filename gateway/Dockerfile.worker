FROM python:3.12-slim

WORKDIR /app

COPY gateway/requirements.worker.txt ./gateway/requirements.worker.txt
RUN pip install --no-cache-dir -r gateway/requirements.worker.txt

# Only what the pipeline reads at run time: the worker code, config (prices, brand),
# Chiara's templates and the pipeline package itself - not the whole deliverables folder.
COPY gateway/ ./gateway/
COPY config/ ./config/
COPY templates/ ./templates/
COPY deliverables/2026-05-25_016_aistudio-langgraph/ ./deliverables/2026-05-25_016_aistudio-langgraph/
# Pipeline v2 (PIPELINE_VERSION=v2) is loaded from file, and the weekly research digest runs the research team's code.
COPY deliverables/2026-10-16_040_studio-pipeline-v2/ ./deliverables/2026-10-16_040_studio-pipeline-v2/
COPY scripts/github_research/ ./scripts/github_research/

ENV PYTHONUNBUFFERED=1

EXPOSE 8080

# Private service: Cloud Run lets in only the pipeline-tasks service account (Cloud Tasks, OIDC).
CMD ["sh", "-c", "uvicorn gateway.pipeline_worker:app --host 0.0.0.0 --port ${PORT:-8080}"]
