{
  "_comment": "Claude Code settings for AI Studio Accademia Milano. Hooks auto-updated by learning_loop.py and post_delivery_update.py.",

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m scripts.rag.inject_context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/learning_loop.py --event session_end --audit-dir process/audit --settings config/global_settings.json --claude-dir C:\\Users\\l_ace\\.claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "gmail_api",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/check_oauth.py --provider gmail 2>&1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__github__push_files",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/learning_loop.py --event delivery_complete --audit-dir process/audit --settings config/global_settings.json --claude-dir C:\\Users\\l_ace\\.claude"
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(python -m scripts.rag.inject_context:*)",
      "Bash(python -m scripts.rag.embed_repo:*)",
      "Bash(python -m scripts.rag.retrieve_repo:*)",
      "Bash(python -m scripts.rag.synthesize:*)",
      "Bash(python scripts/learning_loop.py:*)",
      "Bash(python scripts/post_delivery_update.py:*)",
      "Bash(python scripts/check_oauth.py:*)",
      "Bash(git add process/audit/*)",
      "Bash(git add config/global_settings.json)",
      "Bash(git add .claude/settings.json)",
      "Bash(git add CLAUDE.md)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
